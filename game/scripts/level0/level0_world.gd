class_name Level0World
extends Space
## The infinite Level 0 (M2): 24 x 24 m chunks generated by Level0Gen and built by
## Level0Chunk, streamed around the player.
##
## Streaming rules (see DECISIONS D015):
## - Chunks within LOAD_R of the player exist; beyond UNLOAD_R they are freed. SDFGI only
##   voxelizes geometry when a cascade scrolls over it, and its largest cascade reaches about
##   26 m, so chunks must be complete well before they come that close (LOAD_R 40 m).
## - A chunk is built in small steps, a fixed number per frame (never time-based), so a seed
##   reproduces the same frames under Movie Maker.
## - Only panels near the player get a real light and hum (FixturePool).

const CHUNK := 24.0
const LOAD_R := 40.0
const UNLOAD_R := 58.0
const STEPS_PER_FRAME := 1

var gen: Level0Gen
var mats: Dictionary
var seed_offset := Vector2.ZERO
var chunks := {}              # Vector2i -> Level0Chunk (complete)
var _queue: Array[Vector2i] = []
var _building_coord := Vector2i(1 << 20, 0)
var _building_chunk: Level0Chunk
var _steps: Array = []
var pool: FixturePool
var director: Level0Director
var tape: TapeEvents
var _player := Vector3.ZERO
var _stream_t := 0.0
var build_log: Array = []     # [frame, coord, step, msec] for profiling


func build(p_seed: int) -> void:
	super.build(p_seed)
	space_id = &"level0"
	gen = Level0Gen.new(p_seed, float(Game.opts.get("fidelity", "0.9")))
	var r := Game.rng("level0:look")
	seed_offset = Vector2(r.randf_range(0.0, 50.0), r.randf_range(0.0, 50.0))
	mats = Level0Look.make_materials(seed_offset)
	pool = FixturePool.new()
	pool.name = "fixture_pool"
	add_child(pool)
	director = Level0Director.new()
	director.space = self
	add_child(director)
	tape = TapeEvents.new()
	tape.name = "tape_events"
	tape.space = self
	add_child(tape)
	# The first ring is built at once (this is the loading moment); the rest streams.
	var start := Vector3(12, 0, 12)
	_player = start
	for c in _wanted(start):
		_build_now(c)
	_player = get_spawn_transform().origin


# ------------------------------------------------------------------ chunk bookkeeping

static func chunk_of(p: Vector3) -> Vector2i:
	return Vector2i(floori(p.x / CHUNK), floori(p.z / CHUNK))


static func chunk_rect(c: Vector2i) -> Rect2:
	return Rect2(Vector2(c) * CHUNK, Vector2(CHUNK, CHUNK))


static func _rect_dist(r: Rect2, p: Vector2) -> float:
	var q := Vector2(clampf(p.x, r.position.x, r.end.x), clampf(p.y, r.position.y, r.end.y))
	return p.distance_to(q)


func _wanted(p: Vector3) -> Array[Vector2i]:
	var pc := chunk_of(p)
	var out: Array[Vector2i] = []
	var p2 := Vector2(p.x, p.z)
	var n := int(ceil(LOAD_R / CHUNK)) + 1
	for dx in range(-n, n + 1):
		for dz in range(-n, n + 1):
			var c := pc + Vector2i(dx, dz)
			if _rect_dist(chunk_rect(c), p2) < LOAD_R:
				out.append(c)
	out.sort_custom(func(a, b): return _rect_dist(chunk_rect(a), p2) < _rect_dist(chunk_rect(b), p2))
	return out


func _new_chunk(c: Vector2i) -> Level0Chunk:
	var ch := Level0Chunk.new()
	ch.name = "chunk_%d_%d" % [c.x, c.y]
	ch.pooled = true
	ch.own_far_edges = false
	ch.position = Vector3(c.x * CHUNK, 0.0, c.y * CHUNK)
	add_child(ch)
	return ch


func _build_now(c: Vector2i) -> void:
	var ch := _new_chunk(c)
	ch.build(gen.generate(c.x, c.y), "c%d_%d:" % [c.x, c.y], mats, seed_offset)
	_finish(c, ch)


func _finish(c: Vector2i, ch: Level0Chunk) -> void:
	chunks[c] = ch
	for fx in ch.fixtures:
		director.fixtures.append(fx)
		if fx.mount == Fixture.Mount.CEILING:
			pool.fixtures.append(fx)


func _unload(c: Vector2i) -> void:
	var ch: Level0Chunk = chunks[c]
	for fx in ch.fixtures:
		pool.release(fx)
		pool.fixtures.erase(fx)
		director.fixtures.erase(fx)
	chunks.erase(c)
	ch.queue_free()


func _stream() -> void:
	var p2 := Vector2(_player.x, _player.z)
	# Free what is far behind.
	for c in chunks.keys():
		if _rect_dist(chunk_rect(c), p2) > UNLOAD_R:
			_unload(c)
	# Queue what is missing, nearest first.
	_queue.clear()
	for c in _wanted(_player):
		if not chunks.has(c) and c != _building_coord:
			_queue.append(c)


var _pos_log_t := 0.0


func _process(delta: float) -> void:
	if Game.opts.has("log-stream"):
		_pos_log_t -= delta
		if _pos_log_t <= 0.0:
			_pos_log_t = 10.0
			print("[pos] t=%.0f (%.1f, %.1f)" % [Game.clock, _player.x, _player.z])
	_stream_t -= delta
	if _stream_t <= 0.0:
		_stream_t = 0.25
		_stream()
	for k in STEPS_PER_FRAME:
		if _steps.is_empty():
			if _building_chunk:
				_finish(_building_coord, _building_chunk)
				_building_chunk = null
				_building_coord = Vector2i(1 << 20, 0)
			if _queue.is_empty():
				break
			var c: Vector2i = _queue.pop_front()
			if chunks.has(c):
				continue
			_building_coord = c
			_building_chunk = _new_chunk(c)
			_steps = _building_chunk.begin_build(gen.generate(c.x, c.y), "c%d_%d:" % [c.x, c.y], mats, seed_offset)
		else:
			var t0 := Time.get_ticks_usec()
			var st: Callable = _steps.pop_front()
			st.call()
			if Game.opts.has("log-stream"):
				build_log.append([Game.frame, _building_coord, _steps.size(), (Time.get_ticks_usec() - t0) / 1000.0])
				print("[stream] frame=%d chunk=%s steps_left=%d ms=%.2f" % [Game.frame, _building_coord, _steps.size(), (Time.get_ticks_usec() - t0) / 1000.0])


# ------------------------------------------------------------------ Space API

func _chunk_at(p: Vector3) -> Level0Chunk:
	return chunks.get(chunk_of(p), null)


func _local(ch: Level0Chunk, p: Vector3) -> Vector3:
	return p - ch.position


func get_spawn_transform() -> Transform3D:
	var ch: Level0Chunk = chunks.get(Vector2i.ZERO)
	var s: Array = ch.L.get("spawn", [12.0, 12.0, 90.0])
	var p := Vector3(s[0], 0.0, s[1])
	# Face the longest open view.
	var best_yaw := 0.0
	var best_d := -1.0
	for k in 16:
		var yaw := TAU * k / 16.0
		var d := view_depth(p, yaw, 30.0)
		if d > best_d:
			best_d = d
			best_yaw = yaw
	return Transform3D(Basis(Vector3.UP, best_yaw), p)


func make_environment() -> Environment:
	return Level0Look.make_environment(Game.preset)


func make_camera_attributes() -> CameraAttributes:
	return Level0Look.make_camera_attributes()


func is_walkable(p: Vector3) -> bool:
	var ch := _chunk_at(p)
	return ch != null and ch.is_walkable(_local(ch, p))


func view_depth(p: Vector3, yaw: float, max_d: float = 20.0) -> float:
	var dir := Vector3(-sin(yaw), 0.0, -cos(yaw))
	var d := 0.0
	while d < max_d:
		d += 0.2
		if not is_walkable(p + dir * d):
			return d
	return max_d


func floor_wetness(p: Vector3) -> float:
	var ch := _chunk_at(p)
	return ch.floor_wetness(_local(ch, p)) if ch else 0.0


func get_interest_points() -> Array:
	var out := []
	var pc := chunk_of(_player)
	for dx in range(-1, 2):
		for dz in range(-1, 2):
			var c := pc + Vector2i(dx, dz)
			if not chunks.has(c):
				continue
			var ch: Level0Chunk = chunks[c]
			for it in ch.get_interest_points():
				out.append({"name": "%d_%d_%s" % [c.x, c.y, it["name"]], "pos": (it["pos"] as Vector3) + ch.position})
	return out


var _last_chunk := Vector2i(1 << 20, 0)


func set_listener(p: Vector3) -> void:
	if Game.opts.has("log-stream") and chunk_of(p) != _last_chunk:
		_last_chunk = chunk_of(p)
		print("[stream] t=%.1f player chunk %s pos (%.1f, %.1f) loaded=%d" % [Game.clock, _last_chunk, p.x, p.z, chunks.size()])
	_player = p
	pool.listener = p
	director.listener = p


func attach_player(p: Player) -> void:
	tape.player = p


## The lit ceiling panel nearest to p (within r), or null.
func fixture_near(p: Vector3, r: float) -> Fixture:
	var best: Fixture = null
	var bd := r
	for fx in pool.fixtures:
		if not is_instance_valid(fx):
			continue
		var d := Vector2(fx.global_position.x - p.x, fx.global_position.z - p.z).length()
		if d < bd and fx.level > 0.5:
			bd = d
			best = fx
	return best


func set_view(_p: Vector3, fwd: Vector3) -> void:
	director.view_fwd = fwd


## Path across chunks: a breadth-first search over loaded chunks, then the grid path inside each
## chunk to a crossing point on the shared edge (a gate both sides can stand in).
func find_path(from: Vector3, to: Vector3) -> PackedVector3Array:
	var ca := chunk_of(from)
	var cb := chunk_of(to)
	if not chunks.has(ca) or not chunks.has(cb):
		return PackedVector3Array()
	var seq := _chunk_route(ca, cb)
	if seq.is_empty():
		if Game.opts.has("log-stream"):
			print("[path] no chunk route %s -> %s" % [ca, cb])
		return PackedVector3Array()
	var out := PackedVector3Array()
	var cur := from
	for i in seq.size():
		var c: Vector2i = seq[i]
		var ch: Level0Chunk = chunks[c]
		var target := to
		var next_start := Vector3.ZERO
		if i < seq.size() - 1:
			var cross := _crossing(c, seq[i + 1], cur, to)
			if cross.is_empty():
				if Game.opts.has("log-stream"):
					print("[path] no crossing %s -> %s" % [c, seq[i + 1]])
				return out
			target = cross[0]
			next_start = cross[1]
		var part := ch.find_path(_local(ch, cur), _local(ch, target))
		for q in part:
			out.append(q + ch.position)
		if i < seq.size() - 1:
			out.append(next_start)
			cur = next_start
	return out


func _chunk_route(a: Vector2i, b: Vector2i) -> Array:
	var prev := {a: a}
	var frontier: Array[Vector2i] = [a]
	while not frontier.is_empty():
		var c: Vector2i = frontier.pop_front()
		if c == b:
			break
		for d in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
			var n: Vector2i = c + d
			if chunks.has(n) and not prev.has(n):
				prev[n] = c
				frontier.append(n)
	if not prev.has(b):
		return []
	var seq := [b]
	while seq[0] != a:
		seq.push_front(prev[seq[0]])
	return seq


## A point just inside chunk a and its twin just inside chunk b on their shared edge, chosen
## among the open gates to keep the walk short. Returns [in_a, in_b] (world) or [].
func _crossing(a: Vector2i, b: Vector2i, from: Vector3, to: Vector3) -> Array:
	var cha: Level0Chunk = chunks[a]
	var chb: Level0Chunk = chunks[b]
	var d := b - a
	var gates: Array = cha.L["gates"]["E" if d.x > 0 else ("W" if d.x < 0 else ("S" if d.y > 0 else "N"))]
	var best := []
	var best_cost := 1e9
	for g in gates:
		var ts := [(g[0] + g[1]) * 0.5]
		var t0: float = g[0] + 0.3
		while t0 <= g[1] - 0.3:
			ts.append(t0)
			t0 += 0.6
		for t in ts:
			var pa: Vector3
			var pb: Vector3
			var base := cha.position
			if d.x != 0:
				var x := CHUNK if d.x > 0 else 0.0
				pa = base + Vector3(x - 0.25 * d.x, 0.0, t)
				pb = base + Vector3(x + 0.25 * d.x, 0.0, t)
			else:
				var z := CHUNK if d.y > 0 else 0.0
				pa = base + Vector3(t, 0.0, z - 0.25 * d.y)
				pb = base + Vector3(t, 0.0, z + 0.25 * d.y)
			if cha.is_walkable(_local(cha, pa)) and chb.is_walkable(_local(chb, pb)):
				var cost := from.distance_to(pa) + pb.distance_to(to)
				if cost < best_cost:
					best_cost = cost
					best = [pa, pb]
	return best


## Hand-posed review shots chosen by the level itself (capture --focus=auto): the landmarks and
## splice errors near the spawn, framed from a few meters away, plus a few open views.
func get_focus_shots(n: int = 8) -> Array:
	var out := []
	# The opening view down the spawn hall.
	var spawn_xf := get_spawn_transform()
	out.append({"pos": [spawn_xf.origin.x, spawn_xf.origin.z], "yaw": rad_to_deg(-spawn_xf.basis.get_euler().y), "pitch": 1.0, "settle": 2.5})
	var keys := chunks.keys()
	keys.sort_custom(func(a, b): return a.length_squared() < b.length_squared() or (a.length_squared() == b.length_squared() and (a.x < b.x or (a.x == b.x and a.y < b.y))))
	for c in keys:
		var ch: Level0Chunk = chunks[c]
		var L: Dictionary = ch.L
		var marks := []
		for st in L.get("stairs", []):
			marks.append([Vector2(st[0], st[1]) + Vector2(st[2], st[3]) * 2.5, 14.0])
		for sp in L.get("splices", []):
			marks.append([Vector2(sp["pos"][0], sp["pos"][1]), 18.0 if sp.get("flip", false) else -4.0])
		for f in L.get("floor_fixtures", []) + L.get("wall_fixtures", []):
			marks.append([Vector2(f[0], f[1]), 2.0])
		for es in L.get("exit_signs", []):
			marks.append([Vector2(es[0], es[1]), 8.0])
		for m in marks:
			var target := Vector3(m[0].x, 0.0, m[0].y) + ch.position
			var pose := _pose_toward(target, float(m[1]))
			if not pose.is_empty():
				out.append(pose)
	# Fill with open views from interest points.
	for it in get_interest_points():
		if out.size() >= n:
			break
		var p: Vector3 = it["pos"]
		if not is_walkable(p):
			continue
		var best_yaw := 0.0
		var best_d := -1.0
		for k in 12:
			var d := view_depth(p, TAU * k / 12.0, 30.0)
			if d > best_d:
				best_d = d
				best_yaw = TAU * k / 12.0
		# Focus yaw is the mirror of the player's yaw (capture_director spawns with -yaw).
		out.append({"pos": [p.x, p.z], "yaw": rad_to_deg(-best_yaw), "pitch": -2.0, "settle": 2.5})
	return out.slice(0, n)


## A standing spot 2.5 to 4 m from target with a clear line of sight, looking at it.
func _pose_toward(target: Vector3, pitch: float) -> Dictionary:
	for dist in [3.2, 2.6, 4.0]:
		for k in 8:
			var a := TAU * k / 8.0
			var p: Vector3 = target + Vector3(sin(a), 0.0, cos(a)) * dist
			if not is_walkable(p):
				continue
			var to: Vector3 = target - p
			var yaw := atan2(-to.x, -to.z)
			if view_depth(p, yaw, dist) < dist - 0.7:
				continue
			return {"pos": [p.x, p.z], "yaw": rad_to_deg(-yaw), "pitch": pitch, "settle": 2.5}
	return {}
